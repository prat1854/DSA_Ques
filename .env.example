# 2. Press F12 -> Application tab -> Cookies -> https://leetcode.com
# 3. Copy the 'LEETCODE_SESSION' cookie value and paste below.
# 4. (Optional) Copy 'csrftoken' value.
LEETCODE_SESSION=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..7at2MnW7cagjhJ-vINPXvDaJYZbrPgnfRkHaYlWufIg
LEETCODE_CSRF_TOKEN=

# LeetCode Username (defaults to ggZclYw4IT if empty)
LEETCODE_USERNAME=ggZclYw4IT

# Number of recent submissions to inspect (default: 15)
SYNC_LIMIT=15
